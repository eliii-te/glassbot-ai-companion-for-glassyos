#!/usr/bin/env bash
#
# glassbot — setup installer
#
# Installs glassbot from THIS folder onto your system:
#   1. checks Python (and optionally ollama)
#   2. copies glassbot + glassbot-backend → ~/.local/bin/
#   3. copies the Quickshell widget → ~/.config/hypr/scripts/quickshell/glassbot/
#      (only when a Hyprland/quickshell setup is detected)
#   4. creates ~/.config/glassbot/config.json from the example (if none exists)
#   5. verifies the install, prints next steps, then DELETES ITSELF
#
# Usage:  bash setup     (or:  ./setup)   — run from inside the folder
# Flags:  -y / --yes     assume yes for all prompts (non-interactive)
# Env:    SETUP_SKIP_DEPS=1   skip dependency prompts (dev/testing only)
#
set -u

VERSION="0.6.0"
FLAG_YES=0
for a in "$@"; do
  case "$a" in
    -y|--yes) FLAG_YES=1 ;;
    -h|--help)
      sed -n '2,16p' "$0"
      exit 0 ;;
    *) echo "unknown option: $a (only -y/--yes is supported)" >&2; exit 2 ;;
  esac
done

SELF_PATH="$(readlink -f "$0" 2>/dev/null || echo "$0")"
HERE="$(cd "$(dirname "$SELF_PATH")" && pwd)"
SRC_ENTRY="$HERE/glassbot"
SRC_BACKEND="$HERE/glassbot-backend"
SRC_WIDGET="$HERE/quickshell/Glassbot.qml"
SRC_CONFIG_EXAMPLE="$HERE/config.example.json"
QS_WIDGET_DIR="$HOME/.config/hypr/scripts/quickshell/glassbot"
CFG_DIR="$HOME/.config/glassbot"
CFG_DEST="$CFG_DIR/config.json"

# ── colors (only when tty) ────────────────────────────────────────────────
if [ -t 1 ]; then
  C_G="\033[32m"; C_Y="\033[33m"; C_R="\033[31m"; C_B="\033[1m"; C_0="\033[0m"
else
  C_G=""; C_Y=""; C_R=""; C_B=""; C_0=""
fi
ok()   { printf "${C_G}  ✔${C_0} %s\n" "$*"; }
warn() { printf "${C_Y}  ⚠${C_0} %s\n" "$*"; }
fail() { printf "${C_R}  ✖${C_0} %s\n" "$*"; }
step() { printf "\n${C_B}== %s ==${C_0}\n" "$*"; }

confirm() { # $1 = question; default yes
  if [ "$FLAG_YES" = 1 ]; then
    printf "${C_B}?${C_0} %s [Y/n] -> y\n" "$1"
    return 0
  fi
  printf "${C_B}?${C_0} %s [Y/n] " "$1"
  local ans
  IFS= read -r ans || true
  case "${ans:-y}" in
    [yY]*) return 0 ;;
    *) return 1 ;;
  esac
}

banner() {
  cat <<'EOF'

    ██████╗ ██╗      █████╗ ███████╗███████╗██████╗  ██████╗ ████████╗
   ██╔════╝ ██║     ██╔══██╗██╔════╝██╔════╝██╔══██╗██╔═══██╗╚══██╔══╝
   ██║  ███╗██║     ███████║███████╗███████╗██████╔╝██║   ██║   ██║
   ██║   ██║██║     ██╔══██║╚════██║╚════██║██╔══██╗██║   ██║   ██║
   ╚██████╔╝███████╗██║  ██║███████║███████║██████╔╝╚██████╔╝   ██║
    ╚═════╝ ╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚═════╝  ╚═════╝    ╚═╝
EOF
  printf "  ${C_B}glassbot — setup installer v%s${C_0}\n\n" "$VERSION"
}

# ── main ──────────────────────────────────────────────────────────────────
main() {
  banner
  echo "This installer sets up glassbot from this folder:"
  echo "  • copies glassbot + glassbot-backend → ~/.local/bin/"
  echo "  • copies the Quickshell widget (if Hyprland/quickshell detected)"
  echo "  • creates ~/.config/glassbot/config.json from the example"
  echo "On success this file deletes itself."
  echo

  # --- 0. sanity -----------------------------------------------------------
  if [ ! -f "$SRC_ENTRY" ] || [ ! -f "$SRC_BACKEND" ]; then
    fail "glassbot / glassbot-backend not found next to this installer."
    echo "  Expected: $HERE/glassbot and $HERE/glassbot-backend"
    exit 1
  fi
  if [ "$(uname -s)" != "Linux" ]; then
    fail "glassbot targets Linux (GlassyOS)."
    exit 1
  fi

  # --- 1. dependencies ------------------------------------------------------
  step "Dependencies"
  if ! command -v python3 >/dev/null 2>&1; then
    fail "python3 is required (install it with your package manager)."
    exit 1
  fi
  ok "python3 present"
  if command -v ollama >/dev/null 2>&1; then
    ok "ollama present (local models)"
  else
    warn "ollama not found — glassbot still works with a cloud provider,"
    echo "      but local chat needs ollama. Install from https://ollama.com"
  fi
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || [ -d "$HOME/.config/hypr" ]; then
    ok "Hyprland setup detected — widget will be installed"
    INSTALL_WIDGET=1
  else
    warn "no Hyprland setup detected — skipping the desktop widget"
    INSTALL_WIDGET=0
  fi

  # --- 2. install the binaries ------------------------------------------------
  step "Installing glassbot"
  BIN_DIR="$HOME/.local/bin"
  mkdir -p "$BIN_DIR"
  cp "$SRC_ENTRY" "$BIN_DIR/glassbot"
  cp "$SRC_BACKEND" "$BIN_DIR/glassbot-backend"
  chmod +x "$BIN_DIR/glassbot" "$BIN_DIR/glassbot-backend"
  ok "installed glassbot + glassbot-backend → $BIN_DIR/"

  # --- 3. widget --------------------------------------------------------------
  if [ "$INSTALL_WIDGET" = "1" ]; then
    step "Quickshell widget"
    if [ -f "$SRC_WIDGET" ]; then
      mkdir -p "$QS_WIDGET_DIR"
      cp "$SRC_WIDGET" "$QS_WIDGET_DIR/Glassbot.qml"
      ok "widget installed → $QS_WIDGET_DIR/Glassbot.qml"
      warn "make sure your quickshell config loads widgets from"
      echo "      ~/.config/hypr/scripts/quickshell/ and bind SUPER+CTRL+A to"
      echo "      'glassbot' (or run 'glassbot' to toggle the widget)"
    else
      warn "Glassbot.qml not found — skipping widget"
    fi
  fi

  # --- 4. config --------------------------------------------------------------
  step "Config"
  mkdir -p "$CFG_DIR"
  if [ ! -f "$CFG_DEST" ]; then
    cp "$SRC_CONFIG_EXAMPLE" "$CFG_DEST"
    ok "created $CFG_DEST"
    warn "review it — for cloud replies add your key via env var, e.g.:"
    echo "      export OPENROUTER_API_KEY=...   (keeps the config file key-free)"
  else
    ok "config already exists: $CFG_DEST"
  fi

  # --- 5. PATH ----------------------------------------------------------------
  case ":$PATH:" in
    *":$BIN_DIR:"*) : ;;
    *)
      RC="$HOME/.bashrc"
      case "${SHELL:-/bin/bash}" in
        *zsh) RC="$HOME/.zshrc" ;;
      esac
      if ! grep -qF "export PATH=\"\$HOME/.local/bin" "$RC" 2>/dev/null; then
        printf '\n# added by glassbot setup\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$RC"
        ok "added ~/.local/bin to PATH in $RC"
        echo "  → open a new terminal (or: source $RC) before running glassbot"
      fi
      ;;
  esac

  # --- 6. verify + cleanup ----------------------------------------------------
  step "Verification"
  if [ -x "$BIN_DIR/glassbot" ] && [ -x "$BIN_DIR/glassbot-backend" ]; then
    ok "glassbot is installed"
    echo
    echo "  Next steps:"
    echo "    1. glassbot --status        → check backend / ollama"
    echo "    2. glassbot \"hello!\"         → one-shot chat"
    echo "    3. glassbot --tui            → terminal chat"
    echo "    4. (Hyprland) bind SUPER+CTRL+A → 'glassbot' for the widget"
    echo
    if [ "$FLAG_YES" = 1 ]; then
      rm -f "$0"
    else
      if confirm "Delete this installer file?"; then
        rm -f "$0"
      else
        warn "leaving installer in place — you can delete it later"
      fi
    fi
  else
    fail "install verification failed — copy manually:"
    echo "  install -m755 \"$SRC_ENTRY\" ~/.local/bin/glassbot"
    echo "  install -m755 \"$SRC_BACKEND\" ~/.local/bin/glassbot-backend"
    exit 1
  fi
}

main
