def load_config():
    cfg = {
        "model": DEFAULT_MODEL,
        "ollama_url": OLLAMA_URL,
        "search_results": SEARCH_RESULTS,
        # Backend routing: "auto" (cloud if key present, else local),
        # "local" (always Ollama), or "cloud".
        "backend": "auto",
        "cloud_provider": DEFAULT_CLOUD_PROVIDER,
        "cloud_url": OPENROUTER_URL,
        "cloud_model": DEFAULT_CLOUD_MODEL,
        "cloud_api_key": "",
        "setup_done": False,
        # Tool execution (LLM-initiated bash with user approval).
        "tools_enabled": True,
    }
    if CONFIG_FILE.is_file():
        try:
            cfg.update(json.loads(CONFIG_FILE.read_text()))
        except Exception:
            pass
    # Resolve provider config — url and default model follow the chosen
    # provider unless the user explicitly overrode them in config.json.
    prov_id = cfg.get("cloud_provider") or DEFAULT_CLOUD_PROVIDER
    if prov_id not in CLOUD_PROVIDERS:
        prov_id = DEFAULT_CLOUD_PROVIDER
    prov = CLOUD_PROVIDERS[prov_id]
    cfg["cloud_provider"] = prov_id
    if cfg.get("cloud_url") in (None, "", OPENROUTER_URL,
                                 CLOUD_PROVIDERS["groq"]["url"]):
        cfg["cloud_url"] = prov["url"]
    # If user is using a default model from a different provider, swap to
    # this provider's default. Detected by checking known-default values.
    known_defaults = {p["default_model"] for p in CLOUD_PROVIDERS.values()}
    known_defaults |= LEGACY_CLOUD_DEFAULTS
    if not cfg.get("cloud_model") or cfg.get("cloud_model") in known_defaults:
        cfg["cloud_model"] = prov["default_model"]
    # Key resolution: env var > config.json > standalone keyfile.
    # Accept either OPENROUTER_API_KEY (preferred) or the older GROQ_API_KEY
    # name so an existing dotfile keeps working after the v0.4.1 swap.
    env_key = (os.environ.get("OPENROUTER_API_KEY")
               or os.environ.get("GROQ_API_KEY") or "").strip()
    if env_key:
        cfg["cloud_api_key"] = env_key
    elif not cfg["cloud_api_key"]:
        for fname in ("openrouter_api_key", "groq_api_key"):
            keyfile = CONFIG_DIR / fname
            if keyfile.is_file():
                try:
                    cfg["cloud_api_key"] = keyfile.read_text().strip()
                    break
                except Exception:
                    pass
    # If the configured local model isn't present, fall back to whatever is
    # locally installed so the user gets *something* working instead of a
    # hard error. Best-effort: skip silently if ollama is offline.
    try:
        with urllib.request.urlopen(cfg["ollama_url"] + "/api/tags", timeout=2) as r:
            installed = {m.get("name", "") for m in json.loads(r.read()).get("models", [])}
        if cfg["model"] not in installed:
            for cand in FALLBACK_MODELS:
                if cand in installed:
                    cfg["model"] = cand
                    break
    except Exception:
        pass
    # "Always cloud when possible": if a key is present and the user hasn't
    # explicitly pinned a backend, prefer cloud and skip the silent
    # cloud→local fallback. /local and /cloud slash overrides still work
    # because they pass `prefer` directly into chat_stream.
    if cfg.get("cloud_api_key") and cfg.get("backend", "auto") == "auto":
        cfg["backend"] = "cloud"
    return cfg


def save_config_patch(patch):
    """Merge `patch` into the on-disk config.json. Creates the file/dir as
    needed. Existing keys we don't touch are preserved. Returns the merged
    config dict."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    existing = {}
    if CONFIG_FILE.is_file():
        try:
            existing = json.loads(CONFIG_FILE.read_text()) or {}
        except Exception:
            existing = {}
    existing.update(patch)
    CONFIG_FILE.write_text(json.dumps(existing, indent=2, ensure_ascii=False))
    return existing


